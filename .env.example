# Local development can omit DATABASE_URL (SQLite file is created automatically).
# PostgreSQL example:
DATABASE_URL=postgresql+psycopg://kisan_user:change_this_password@localhost:5432/kisan_connect

# Set the public HTTPS URL used by the browser (needed if the hosting proxy hides forwarded headers).
PUBLIC_ORIGIN=https://kisan-connect.getvoroa.com

# Set true behind HTTPS in production.
COOKIE_SECURE=true
SESSION_DAYS=7

# Optional: creates the first admin only when both values are set.
ADMIN_NAME=Kisan Connect Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-long-random-password

# Optional: free API key from https://data.gov.in/ to enable official AGMARKNET prices.
# Without this key, the app only displays community averages after 3 distinct accounts report the same market/crop within 3 days.
DATA_GOV_IN_API_KEY=
AGMARKNET_RESOURCE_ID=9ef84268-d588-465a-a308-a864a43d0070

# Optional real AI crop image analysis. Keep key server-side only.
GEMINI_API_KEY=

# Optional HTTPS JSON feed for government scheme announcements.
# Feed must return an object containing items, records or results; each item needs title and an official HTTPS url.
SCHEME_FEED_URL=

# OTP and WhatsApp are not active until a verified provider and consent flow are configured.
# Do not place SMS/WhatsApp provider secrets in frontend JavaScript.
